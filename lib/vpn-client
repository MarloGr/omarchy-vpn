#!/usr/bin/env python3
"""Unprivileged client for the tightly scoped VPN control socket."""
import socket
import sys

request = " ".join(sys.argv[1:])
if not request:
    raise SystemExit(2)
try:
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.settimeout(50)
        client.connect("/run/omarchy-vpn/control.sock")
        client.sendall((request + "\n").encode("ascii"))
        response = client.recv(512).decode(errors="replace").strip()
except (OSError, UnicodeError) as error:
    print(f"VPN control unavailable: {error}", file=sys.stderr)
    raise SystemExit(1)
if response != "OK":
    print(response.removeprefix("ERR "), file=sys.stderr)
    raise SystemExit(1)
