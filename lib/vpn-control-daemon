#!/usr/bin/env python3
"""Minimal privileged control socket for Omarchy VPN.

The protocol deliberately accepts only a small fixed command vocabulary. It
never invokes a shell and never accepts paths, options, or arbitrary arguments.
"""
import grp
import os
import re
import socket
import subprocess

SOCKET = "/run/omarchy-vpn/control.sock"
ROOTCTL = "/usr/local/lib/omarchy-vpn/vpnctl-root"
PROFILE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$")


def validated(line: str) -> list[str] | None:
    parts = line.strip().split()
    if parts in (["disconnect"], ["auto"], ["status"]):
        return parts
    if len(parts) == 2 and parts[0] == "connect" and PROFILE.fullmatch(parts[1]):
        return parts
    if len(parts) == 2 and parts[0] in {"set-autoconnect", "set-killswitch"} and parts[1] in {"on", "off"}:
        return parts
    return None


os.makedirs(os.path.dirname(SOCKET), mode=0o755, exist_ok=True)
try:
    os.unlink(SOCKET)
except FileNotFoundError:
    pass

with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as server:
    server.bind(SOCKET)
    os.chown(SOCKET, 0, grp.getgrnam("wheel").gr_gid)
    os.chmod(SOCKET, 0o660)
    server.listen(8)
    while True:
        connection, _ = server.accept()
        with connection:
            try:
                request = connection.recv(256).decode("ascii", "strict")
                command = validated(request)
                if command is None or len(request) >= 256 or "\n" in request.strip("\n"):
                    connection.sendall(b"ERR invalid request\n")
                    continue
                result = subprocess.run(
                    [ROOTCTL, *command],
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.PIPE,
                    text=True,
                    timeout=45,
                    check=False,
                )
                if result.returncode == 0:
                    connection.sendall(b"OK\n")
                else:
                    message = result.stderr.strip().splitlines()[-1:] or ["operation failed"]
                    connection.sendall(("ERR " + message[0][:160] + "\n").encode())
            except Exception as error:
                connection.sendall(("ERR " + type(error).__name__ + "\n").encode())
